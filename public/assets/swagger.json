                    "name": {
                        "type": "string",
                        "nullable": true
                    },
                    "qrisImageUrl": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "RegisterRequest": {
                "type": "object",

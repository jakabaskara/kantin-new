                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "TransactionItemDto": {
                "type": "object",
                "properties": {
                    "menuItemId": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "menuName": {
                        "type": "string",
                        "nullable": true
                    },
                    "quantity": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "unitPrice": {
                        "type": "number",
                        "format": "double"
                    },
                    "subTotal": {
                        "type": "number",
                        "format": "double",
                        "readOnly": true
                    }
                },
                "additionalProperties": false
            }

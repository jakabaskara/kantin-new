                        "nullable": true
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "price": {
                        "type": "number",
                        "format": "double"
                    },
                    "outletId": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "outletName": {
                        "type": "string",
                        "nullable": true
                    },
                    "stockQuantity": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "MenuItemUpdateDto": {
                "required": [
                    "name"
                ],
                "type": "object",
                "properties": {
                    "name": {
                        "maxLength": 100,
                        "minLength": 0,
                        "type": "string"
                    },
                    "description": {
                        "maxLength": 255,
                        "minLength": 0,
                        "type": "string",
                        "nullable": true
                    },
                    "price": {
                        "maximum": 100000,
                        "minimum": 0,
                        "type": "number",
                        "format": "double"
                    },
                    "stockQuantity": {
                        "maximum": 1000,
                        "minimum": 0,
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "OutletDto": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "name": {
                        "type": "string",
                        "nullable": true
                    },
                    "location": {
                        "type": "string",
                        "nullable": true
                    },

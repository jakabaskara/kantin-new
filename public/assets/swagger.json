                        "format": "int32"
                    },
                    "customerName": {
                        "type": "string",
                        "nullable": true
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "totalAmount": {
                        "type": "number",
                        "format": "double"
                    },
                    "outletName": {
                        "type": "string",
                        "nullable": true
                    },
                    "items": {
                        "type": "array",

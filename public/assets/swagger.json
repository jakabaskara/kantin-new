                    },
                    "password": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "MenuItemCreateDto": {
                "required": [
                    "name",
                    "outletId"
                ],
                "type": "object",
                "properties": {
                    "name": {
                        "maxLength": 100,
                        "minLength": 0,
                        "type": "string"
                    },
                    "description": {
                        "maxLength": 255,
                        "minLength": 0,
                        "type": "string",
                        "nullable": true
                    },
                    "price": {
                        "maximum": 100000,
                        "minimum": 0,
                        "type": "number",
                        "format": "double"
                    },
                    "outletId": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "initialStockQuantity": {
                        "maximum": 1000,
                        "minimum": 0,
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "MenuItemDto": {
                "type": "object",
